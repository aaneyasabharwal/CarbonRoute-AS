# =================================================================
# CarbonRoute Full-Stack Platform Environment Variables
# =================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Authentication Security. Never commit real values.
# JWT_SECRET: at least 32 random characters. Required in production (the server refuses to
# start without it); in development a random per-process secret is used if it is empty.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial admin account, created only when the database has no users.
# ADMIN_PASSWORD: at least 12 characters, no default. Required in production when no user
# exists; in development the account is simply not created while it is empty.
# To change an existing admin password: NEW_ADMIN_PASSWORD=... npm run admin:set-password
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@carbonroute.org
ADMIN_PASSWORD=

# Electricity Maps API key (real carbon data). Put the real value only in your local
# .env file, never in this example file or in git. See docs/ELECTRICITY_MAPS.md.
ELECTRICITY_MAPS_API_KEY=

# Object Storage Configuration ('local' or 's3')
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./storage/uploads

# AWS S3 / Cloudflare R2 / MinIO Compatible Settings (Required if STORAGE_TYPE=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=carbonroute-presentations
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
